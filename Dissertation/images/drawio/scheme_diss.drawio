        <mxCell id="TniOj67ztibJqwXfHiKC-10" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;Глава 2.&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Имитационная модель и алгоритмы децентрализованной&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;многозадачной координации комплекса роботизированных&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;НТТМ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Times New Roman;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="JfOtEd1yMMRHn9q1p5PB-2">
