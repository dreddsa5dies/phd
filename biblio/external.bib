@ARTICLE{MaillerLesserHorling2003,
	author = {Mailler, R. and Lesser, V. and Horling, B.},
	title = {Cooperative negotiation for soft real-time distributed resource allocation},
	year = {2003},
	isbn = {1581136838},
	publisher = {Association for Computing Machinery},
	address = {New York, NY, USA},
	url = {https://doi.org/10.1145/860575.860667},
	doi = {10.1145/860575.860667},
	abstract = {В этой статье мы представляем протокол совместного согласования, который решает проблему распределенного распределения ресурсов, соблюдая при этом мягкие ограничения реального времени в динамичной среде. В этом протоколе используются два основных принципа, которые позволяют ему работать в постоянно меняющихся условиях. Во-первых, мы формулируем проблему распределения как задачу оптимизации, аналогичную задаче частичного удовлетворения ограничений (PCSP), и используем методы релаксации для получения решений без конфликтов (нарушения ограничений). Во-вторых, используя дублирующие друг друга опосредованные переговоры для проведения поиска, мы можем сократить большую часть поискового пространства, используя форму согласованности дуг. Это позволяет протоколу как быстро выявлять ситуации, в которых проблема связана с чрезмерными ограничениями, так и находить подходящее решение для устранения проблемы с чрезмерными ограничениями. С глобальной точки зрения, протокол работает в режиме "восхождение на холм" и, поскольку он был разработан для работы в динамичных средах, является приблизительным. Мы опишем область, которая вдохновила на создание этого протокола, а также обсудим результаты экспериментов.},
	booktitle = {Proceedings of the Second International Joint Conference on Autonomous Agents and Multiagent Systems},
	pages = {576–583},
	numpages = {8},
	keywords = {cooperative negotiation, distributed problem solving, resource allocation},
	location = {Melbourne, Australia},
	language = {english}
}
@ARTICLE{Zhang2023DiscoveringGM,
	author = {Fuxiang Zhang and Chengxing Jia and Yi-Chen Li and Lei Yuan and Yang Yu and Zongzhang Zhang},
	title = {Discovering Generalizable Multi-agent Coordination Skills from Multi-task Offline Dat},
	journal = {International Conference on Learning Representations},
	year = {2023},
	pages = {24},
	url = {https://iclr.cc/virtual/2023/poster/11262},
	abstract = {Совместное многоагентное обучение с подкреплением сталкивается с проблемой адаптации к множеству задач с различными агентами и целями. Предыдущие многоагентные подходы MARL требовали дорогостоящего взаимодействия для одновременного изучения или точной настройки политик в разных задачах. Однако ситуация, когда агент должен обобщать несколько задач, используя только автономные данные из ограниченного числа задач, больше соответствует потребностям реальных приложений. Поскольку автономные многозадачные данные содержат множество вариантов поведения, эффективным подходом, основанным на данных, является извлечение информативных скрытых переменных, которые могут представлять универсальные навыки для реализации координации между задачами. В этой статье мы предлагаем новый автономный алгоритм MARL для выявления навыков координации из многозадачных данных. ODIS сначала извлекает навыки координации, не зависящие от задач, из автономных многозадачных данных и учится определять различные варианты поведения агентов с помощью обнаруженных навыков координации. Затем мы разрабатываем политику координации для выбора оптимальных навыков координации с использованием парадигмы централизованного обучения и децентрализованного исполнения. Далее мы демонстрируем, что выявленные навыки координации могут определять эффективное координационное поведение, тем самым значительно улучшая обобщение для невидимых задач. Эмпирические результаты совместных тестов MARL, включая мультиагентную игру StarCraft challenge, показывают, что ODIS достигает превосходной производительности в широком спектре задач только при использовании автономных данных из ограниченных источников},
	language = {english}
}
