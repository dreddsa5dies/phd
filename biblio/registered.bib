@Patent{progbib1,
	heading =      {Свидетельство о гос. регистрации программы для {ЭВМ}},
	author =       {Соловьев, В. В.},
	title =        {Симулятор многозадачной координации групп роботизированных наземных транспортно-технологических средств (СМК-НТТС)},
	media =        {СМК-НТТС предназначена для проведения вычислительных экспериментов по оценке эффективности алгоритмов многозадачной координации в группе роботизированных наземных транспортно-технологических средств. Реализует математическую модель, учитывающую динамику энергопотребления, стохастичность поступления задач и неоднородность оборудования машин. Программа может использоваться в научно-исследовательской деятельности для разработки и верификации методов распределенного управления автономными системами, а также в учебном процессе для подготовки специалистов в области робототехники и автоматизации. Функциональные возможности программы включают: реализацию  стратегий распределения задач, модульное управление параметрами симуляции, проведение экспериментов, сбор метрик производительности и генерацию сводных отчетов с графиками. Программа реализована на языке Go.},
	holder =       {Роспатент},
	reqnumber =    2025690320,
	publdate =     {2025-11-06},
	date =         {2025-10-06},
	prnumber =     2025686591,
	prcountry =    {countryru},
	language =     {russian},
	authorprogram ={yes},
}

