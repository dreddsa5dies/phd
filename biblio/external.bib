@ARTICLE{choudhury2020dynamicmultirobottaskallocation,
	title={Dynamic Multi-Robot Task Allocation under Uncertainty and Temporal Constraints},
	author={Choudhury, S. and Gupta, J. K. and Kochenderfer, M. J. and Sadigh, D. and Bohg, J.},
	year={2020},
	journal={arXiv preprint},
	url={https://arxiv.org/abs/2005.13109},
	doi={10.48550/arXiv.2005.13109},
	abstract = {Мы рассматриваем проблему динамического распределения задач между несколькими агентами в условиях ограниченного временного окна и неопределенности завершения задачи. Наша цель - свести к минимуму количество неудачных задач в конце операционного периода. Мы представляем алгоритм распределения нескольких роботов, который устраняет ключевые вычислительные проблемы, связанные с последовательным принятием решений в условиях неопределенности и многоагентной координации, и решает их иерархическим образом. Нижний уровень вычисляет политики для отдельных агентов, используя динамическое программирование с древовидным поиском, а верхний уровень разрешает конфликты в отдельных планах, чтобы получите действительное распределение для нескольких агентов. Наш алгоритм, основанный на точастическом распределении на основе конфликтов (SCoBA), является оптимальным по ожиданиям и завершенным при некоторых разумных предположениях. На практике SCoBA достаточно эффективен в вычислительном отношении, чтобы чередовать планирование и выполнение в режиме онлайн. По показателю успешного выполнения задач SCoBA неизменно превосходит ряд базовых методов и демонстрирует высокую конкурентоспособность по сравнению с oracle с полным прогнозом. Он также хорошо масштабируется за счет количества задач и агентов. Мы проверяем наши результаты с помощью широкого спектра симуляций в двух различных областях: сбор и размещение на конвейерной ленте с несколькими рычагами и отправка груза несколькими беспилотниками в городе.},
	language = {english}
}
@ARTICLE{velhal2021decentralizedmultiuavspatiotemporalmultitask,
	title={A Decentralized Multi-UAV Spatio-Temporal Multi-Task Allocation Approach for Perimeter Defense},
	author={Velhal, S. and Sundaram, S. and Sundararajan, N.},
	year={2021},
	journal={arXiv preprint},
	url={https://arxiv.org/abs/2102.07381},
	doi={10.48550/arXiv.2102.07381},
	abstract = {В данной статье предлагается новый подход к решению многопользовательской игры по защите периметра, в которой команда злоумышленников пытается проникнуть на территорию, а команда защитников защищает территорию, захватывая злоумышленников по периметру территории. Задача защитников - обнаружить и захватить нарушителей до того, как они проникнут на территорию. Каждый защитник самостоятельно обнаруживает нарушителя и вычисляет его траекторию, чтобы совместно захватить назначенных нарушителей. Предполагается, что нарушитель достигнет определенного места на периметре в определенное время. Каждый нарушитель рассматривается как пространственно-временная задача, и защитникам поручается выполнять эти пространственно-временные задачи. В любой момент времени задача защиты периметра преобразуется в задачу децентрализованного пространственно-временного распределения задач для нескольких беспилотных летательных аппаратов (DMUST-MTA). Стоимость выполнения задачи для траектории определяется совокупной функцией затрат как пространственной, так и временной составляющих. В этой статье децентрализованный алгоритм объединения, основанный на консенсусе, был модифицирован для решения проблемы пространственно-временного распределения многозадачности и оценки производительности проверка предложенного подхода проводится на основе моделирования методом Монте-Карло. Результаты моделирования показывают эффективность предложенного подхода для решения задачи защиты периметра при различных сценариях. Сравнение производительности с современным централизованным подходом с полной наблюдаемостью ясно показывает, что DMUST-MTA обеспечивает аналогичную производительность децентрализованным способом в условиях частичной наблюдаемости при меньшем времени вычислений и простоте масштабирования.},
	language = {english}
}
