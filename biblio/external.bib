@ARTICLE{aziz2022taskallocationusingteam,
	title={Task Allocation using a Team of Robots},
	author={Aziz, H. and Pal, A. and Pourmiri, A. and Ramezani, F. and Sims, B.},
	year={2022},
	journal={arXiv preprint},
	url={https://arxiv.org/abs/2207.09650},
	doi={10.48550/arXiv.2207.09650},
	abstract = {В этой статье мы систематически рассматривали и анализировали исследовательские проблемы в области распределения задач между несколькими роботами, уделяя особое внимание подходам, предполагающим координацию действий нескольких роботов. Мы определили очень общую формулировку этой проблемы, охватывающую состояния роботов, задачи и окружающую среду, в которой они работают. Мы обсудили несколько ограничений, накладываемых на роботов и задачи, а также различные целевые функции. Мы также рассмотрели проблему с точки зрения динамических сценариев. Кроме того, мы изучили ее связь с такими хорошо известными проблемами, как маршрут движения транспортных средств и формирование коалиций. Наконец, мы проанализировали множество подходов к решению MRSA, таких как методы, основанные на оптимизации, рыночные и некоторые другие, которые не подпадают ни под одну из этих двух категорий.},
	language = {english}
}
@ARTICLE{wei2022,
	title={Strategic multi-task coordination over regular networks of robots with limited computation and communication capabilities},
	author={Wei, Y. and Vasconcelos, M. M.},
	year={2022},
	journal={arXiv preprint},
	url={https://arxiv.org/abs/2212.10968},
	doi={10.48550/arXiv.2212.10968},
	abstract = {Координация является желательной особенностью мультиагентных систем, позволяющей выполнять задачи, которые были бы невозможны для отдельных агентов. Мы изучаем координацию, осуществляемую командой стратегических агентов, решающих выполнить одну из множества задач. Мы используем стохастическую структуру, в которой агенты выбирают между двумя различными задачами, сложность которых распределена случайным образом и частично контролируется. Мы показываем, что равновесие Нэша с простой и интуитивно понятной линейной структурой существует для диффузного предварительного распределения сложности задачи. Кроме того, мы показываем, что наилучшая реакция любого агента на профиль аффинной стратегии может быть нелинейной, если исходное распределение не является диффузным. Наконец, мы приводим алгоритм, который позволяет нам эффективно вычислять управляемое данными равновесие Нэша в классе аффинных политик.},
	language = {english}
}
@ARTICLE{wang2023multitaskmultiagentsharedlayers,
	title={Multi-Task Multi-Agent Shared Layers are Universal Cognition of Multi-Agent Coordination},
	author={Wang, J. and Zhao, J. and Cao, Z. and Feng, R. and Qin, R. and Yu, Y.},
	year={2023},
	journal={arXiv preprint},
	url={https://arxiv.org/abs/2312.15674},
	doi={10.48550/arXiv.2312.15674},
	abstract = {Мультиагентное обучение с подкреплением - это вершина мультиагентных систем, позволяющая решать сложные задачи в реальном мире, способствующая сотрудничеству и координации между агентами и раскрывающая потенциал для интеллектуального принятия решений в различных областях. Однако обучение мультиагентной сети обучения с подкреплением - это сложная задача, требующая значительных вычислительных ресурсов для взаимодействия с различными переменными среды, извлечения представлений о состоянии и получения знаний для принятия решений. Недавние достижения в области крупномасштабных предварительно обученных моделей разжигают наше любопытство: можем ли мы раскрыть общие знания в мультиагентном обучении с подкреплением и использовать предварительно обученные модели для ускорения подготовки к будущим задачам? Решая эту проблему, мы представляем инновационный подход к многозадачному обучению, который направлен на извлечение и использование общих знаний для принятия решений, таких как сотрудничество и конкуренция, в различных задачах. Наш подход предполагает одновременное обучение нескольких мультиагентных задач, при этом в каждой задаче используются независимые интерфейсные уровни восприятия и общие серверные уровни принятия решений. Это эффективное отделение процесса извлечения представления состояния от процесса принятия решений обеспечивает более эффективное обучение и лучшую переносимость. Чтобы оценить эффективность предложенного нами подхода, мы проводим комплексные эксперименты в двух различных средах: StarCraft Multi-agent Challenge (SMAC) и Google Research Football (GRF). Экспериментальные результаты недвусмысленно демонстрируют плавную возможность переноса общей сети принятия решений на другие задачи, тем самым значительно снижая затраты на обучение и повышая конечную производительность. Кроме того, визуализация подтверждает наличие общих знаний о мультиагентном процессе принятия решений на общих сетевых уровнях, что еще больше подтверждает эффективность нашего подхода.},
	language = {english}
}
@ARTICLE{liu2025scalablemultirobottaskallocation,
	title={Scalable Multi-Robot Task Allocation and Coordination under Signal Temporal Logic Specifications},
	author={Liu, W. and Majcherczyk, N. and Pecora, F.},
	year={2025},
	journal={arXiv preprint},
	url={https://arxiv.org/abs/2503.02719},
	doi={10.48550/arXiv.2503.02719},
	abstract = {Планирование движения с простыми задачами, такими как предотвращение столкновений и достижение цели, может быть эффективно решено с помощью современных планировщиков. Однако сложность разрешенных задач для этих планировщиков ограничена. С другой стороны, сигнально-временная логика (STL) может задавать сложные требования, но алгоритмы планирования движения и управления на основе STL часто сталкиваются с проблемами масштабируемости, особенно в крупных системах со сложными динамическими характеристиками, состоящих из нескольких роботов. В этой статье мы предлагаем алгоритм, который использует лучшее из двух возможных решений. Сначала мы используем планировщик движения одного робота, чтобы эффективно сгенерировать набор альтернативных опорных траекторий для каждого робота. Затем требования к координации определяются с помощью STL, который определяется назначением траекторий и продвижением роботов по этим траекториям. Мы используем смешанную целочисленную линейную программу (MILP) для вычисления назначений задач и целевых показателей прогресса робота с течением времени таким образом, чтобы удовлетворялась спецификация STL. Наконец, для отслеживания целевого прогресса используется локальный контроллер. Моделирование показывает, что наш метод может справляться с задачами со сложными ограничениями и масштабами для больших команд из нескольких роботов и сложных сценариев распределения задач.},
	language = {english}
}
@ARTICLE{app15042216_2025,
	author = {Hu, C. and Wang, C. and Luo, W. and Yang, C. and Xiang, L. and He, Z.},
	title = {A Multitask-Based Transfer Framework for Cooperative Multi-Agent Reinforcement Learning},
	journal = {Applied Sciences},
	year = {2025},
	number = {4},
	url = {https://www.mdpi.com/2076-3417/15/4/2216},
	abstract = {Мультиагентное обучение с подкреплением (MARL) доказало свою эффективность и перспективность в задачах совместной работы в команде. Передаче знаний в MARL также уделяется все большее внимание. По сравнению с передачей знаний в задачах с одним агентом, передача знаний в задачах с несколькими агентами является более сложной из-за необходимости учитывать координацию между агентами. Однако существующие методы, основанные на передаче знаний, фокусируются только на стратегиях или знаниях на уровне агента в рамках одной задачи, и передача знаний в рамках такой конкретной задачи новым и отличающимся типам задач, скорее всего, не удастся. В этой статье мы предлагаем многозадачную систему обучения, называемую MTT в cooperative MARL, которая направлена на одновременное получение общих знаний для совместной работы над несколькими задачами, а затем их применение для решения других связанных задач. Однако модели, полученные в результате многозадачного обучения, могут не работать в других задачах, поскольку градиенты из разных задач могут конфликтовать друг с другом. Чтобы получить модель с общими знаниями, мы предоставляем бесконфликтные обновления, гарантируя положительное точечное произведение между окончательным обновлением и градиентом каждой конкретной задачи. Он также обеспечивает постоянную оптимизацию всех задач. Эксперименты, проведенные в двух популярных средах, StarCraft II Multi-Agent Challenge и Google Research Football, показали, что наш метод превосходит базовые показатели, значительно повышая эффективность совместной работы в команде.},
	doi = {10.3390/app15042216},
	language = {english}
}